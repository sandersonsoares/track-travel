---
import '../styles/roteiro.css';
const files = import.meta.glob<{ default: { title: string; subtitle?: string } }>('../data/*.json', { eager: true });
const trips = Object.entries(files).map(([p, m]) => ({ slug: p.split('/').pop()!.replace('.json', ''), ...m.default }));
---
<!doctype html>
<html lang="pt-BR">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="robots" content="noindex" /><meta name="theme-color" content="#fbfbfa" media="(prefers-color-scheme: light)" /><meta name="theme-color" content="#121416" media="(prefers-color-scheme: dark)" /><title>Roteiros</title></head>
  <body>
    <main class="plan">
      <header class="trip"><h1>Roteiros</h1></header>
      <ul class="index">
        {trips.map((t) => <li><a href={`/roteiros/${t.slug}/`}><strong>{t.title}</strong>{t.subtitle && <span>{t.subtitle}</span>}</a></li>)}
      </ul>
    </main>
  </body>
</html>
<style>
  .index { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--rule); }
  .index a { display: grid; gap: 2px; padding: 16px 0; border-bottom: 1px solid var(--rule); color: inherit; text-decoration: none; }
  .index strong { font-size: 1.0625rem; font-weight: 600; line-height: 1.3; transition: color .15s var(--ease); }
  .index a:hover strong { color: var(--accent); }
  .index span { color: var(--ink-2); font-size: .875rem; }
</style>
