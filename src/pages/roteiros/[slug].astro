---
import Icon from '../../components/Icon.astro';
import '../../styles/roteiro.css';

type Photo = { src: string; page: string; author?: string; license?: string };
type Leg = { mode: string; minutes: number; cost?: number; label?: string };
type Place = { address?: string; hours?: string; website?: string; phone?: string; osm?: string; googleMapsUrl?: string; rating?: number; tripadvisorUrl?: string; instagram?: string; photos: Photo[] };
// A swap the group can make on the day: same slot, another place.
type Alt = { name: string; type?: string; time?: string; end?: string; note?: string; cost?: number; place?: Place; lat?: number; lng?: number };
type Item = { time: string; end?: string; type: string; name: string; place?: Place; image?: Photo; note?: string; cost?: number; lat: number; lng: number; leg?: Leg; alternatives?: Alt[] };
type Day = { date: string; title: string; items: Item[] };
type Trip = { placeholder?: boolean; title: string; subtitle?: string; travelers: number; people?: string[]; countries?: string[]; currency: string; rateBRL: number; rateDate: string; days: Day[] };

export function getStaticPaths() {
  const files = import.meta.glob<{ default: Trip }>('../../data/*.json', { eager: true });
  return Object.entries(files).map(([path, mod]) => ({
    params: { slug: path.split('/').pop()!.replace('.json', '') },
    props: { trip: mod.default },
  }));
}

const { trip } = Astro.props as { trip: Trip };

const local = new Intl.NumberFormat('pt-BR', { style: 'currency', currency: trip.currency });
const brl = new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL', maximumFractionDigits: 0 });
const date = (d: string, o: Intl.DateTimeFormatOptions) => new Date(d + 'T12:00:00').toLocaleDateString('pt-BR', o);

const typeLabel: Record<string, string> = { place: 'Lugar', food: 'Comida', activity: 'Passeio', lodging: 'Hospedagem', transport: 'Transporte', shopping: 'Compras', event: 'Evento' };
const modeLabel: Record<string, string> = { walk: 'a pé', tram: 'de elétrico', metro: 'de metrô', bus: 'de ônibus', train: 'de trem', car: 'de carro' };
const modeName: Record<string, string> = { walk: 'A pé', tram: 'Elétrico', metro: 'Metrô', bus: 'Ônibus', train: 'Trem', car: 'Carro' };
const foreign = trip.currency !== 'BRL';
const conv = (v: number) => (foreign ? `≈ ${brl.format(v * trip.rateBRL)}` : undefined);
const countryName = new Intl.DisplayNames(['pt-BR'], { type: 'region' });
const flag = (cc: string) => String.fromCodePoint(...[...cc.toUpperCase()].map((c) => 0x1f1a5 + c.charCodeAt(0)));
const rate = `Valores por pessoa. Câmbio de ${date(trip.rateDate, { day: '2-digit', month: '2-digit', year: 'numeric' })}: ${local.format(1)} = ${new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(trip.rateBRL)}`;
// OSM opening_hours read in Portuguese ("Mo-Fr 09:00-18:00" → "seg–sex 09:00–18:00").
const hoursPt = (h: string) => h.replace(/\b(Mo|Tu|We|Th|Fr|Sa|Su|PH|off)\b/g, (d) => ({ Mo: 'seg', Tu: 'ter', We: 'qua', Th: 'qui', Fr: 'sex', Sa: 'sáb', Su: 'dom', PH: 'feriados', off: 'fechado' })[d]!).replace(/(\d)-(\d)/g, '$1–$2').replace(/([a-zá])-([a-z])/g, '$1–$2').split(/;\s*|\s·\s/);
const host = (u: string) => u.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
// The item's chosen image leads; OSM/Commons photos follow without repeating it.
const photos = (i: Item) => [...(i.image ? [i.image] : []), ...(i.place?.photos ?? []).filter((p) => p.src !== i.image?.src)];
const km = (k: number) => `${k.toLocaleString('pt-BR', { maximumFractionDigits: k < 10 ? 1 : 0 })} km`;
const altUrl = (a: Alt) => a.place?.googleMapsUrl ?? `https://www.google.com/maps/search/?api=1&query=${a.lat !== undefined ? `${a.lat},${a.lng}` : encodeURIComponent(`${a.name}, ${trip.title}`)}`;
const minutes = (m: number) => (m < 60 ? `${m} min` : `${Math.floor(m / 60)} h${m % 60 ? ` ${m % 60} min` : ''}`);

const dayCost = (d: Day) => d.items.reduce((s, i) => s + (i.cost ?? 0) + (i.leg?.cost ?? 0), 0);
const dayTravel = (d: Day) => d.items.reduce((s, i) => s + (i.leg?.minutes ?? 0), 0);
const total = trip.days.reduce((s, d) => s + dayCost(d), 0);
const first = trip.days[0].date;
const last = trip.days[trip.days.length - 1].date;

// Street routes are fetched once at build time from the keyless FOSSGIS Valhalla server;
// a failed leg falls back to a straight line on the map.
// Walk is pedestrian, road modes are auto; rail has no routing there, so it stays a straight dashed line.
// One call per leg on purpose: the server refuses connections when hit harder.
function decode(str: string): [number, number][] {
  const out: [number, number][] = [];
  let i = 0, lat = 0, lng = 0;
  const next = () => { let r = 0, sh = 0, c; do { c = str.charCodeAt(i++) - 63; r |= (c & 31) << sh; sh += 5; } while (c >= 32); return r & 1 ? ~(r >> 1) : r >> 1; };
  while (i < str.length) { lat += next(); lng += next(); out.push([lat / 1e6, lng / 1e6]); }
  return out;
}
// Once the server is unreachable, skip the remaining legs instead of waiting out each timeout.
// Successful routes are kept for the life of the process, so the dev server does not re-ask on every reload.
type Route = { shape: [number, number][]; km: number };
const routes: Map<string, Route> = ((globalThis as any).__routes ??= new Map());
let routerDown = false;
async function route(a: Item, b: Item, costing: string): Promise<Route | null> {
  const key = `${costing}:${a.lat},${a.lng}:${b.lat},${b.lng}`;
  if (routes.has(key)) return routes.get(key)!;
  if (routerDown) return null;
  const q = { locations: [{ lat: a.lat, lon: a.lng }, { lat: b.lat, lon: b.lng }], costing };
  try {
    const r = await fetch(`https://valhalla1.openstreetmap.de/route?json=${encodeURIComponent(JSON.stringify(q))}`, { signal: AbortSignal.timeout(8000) });
    const t = (await r.json()).trip;
    if (!t?.legs?.[0]?.shape) return null;
    const out = { shape: decode(t.legs[0].shape), km: t.summary.length };
    routes.set(key, out);
    return out;
  } catch { routerDown = true; return null; }
}

// How to get to each stop: the planned mode first (from the data, with its cost), then walk/car estimates
// from the leg's distance (routed, else straight line × 1.3).
// ponytail: flat 4.8 km/h walking and 25 km/h city driving; route both modes if these prove too rough.
type Option = { mode: string; minutes: number; km?: number; cost?: number; note: string; planned?: boolean };
const straightKm = (a: Item, b: Item) => {
  const r = Math.PI / 180, x = (b.lng - a.lng) * r * Math.cos(((a.lat + b.lat) / 2) * r), y = (b.lat - a.lat) * r;
  return Math.hypot(x, y) * 6371 * 1.3;
};
const legOptions: Option[][][] = [];
const mapData = [];
for (const d of trip.days) {
  const legs = [], opts: Option[][] = [];
  // Sequential on purpose: it is a shared public server.
  for (let k = 1; k < d.items.length; k++) {
    const a = d.items[k - 1], b = d.items[k], leg = b.leg; // a leg arrives at its stop
    const mode = leg?.mode ?? 'walk';
    const r = mode === 'train' || mode === 'metro' ? null : await route(a, b, mode === 'walk' ? 'pedestrian' : 'auto');
    legs.push(r?.shape ?? null);
    if (!leg) { opts.push([]); continue; }
    const dist = r?.km ?? straightKm(a, b);
    const o: Option[] = [{ mode, minutes: leg.minutes, km: dist, cost: leg.cost, note: '', planned: true }];
    const walkMin = Math.max(1, Math.round((dist / 4.8) * 60));
    if (mode !== 'walk' && walkMin <= 90) o.push({ mode: 'walk', minutes: walkMin, note: 'Estimativa' });
    if (mode !== 'car') o.push({ mode: 'car', minutes: Math.round((dist / 25) * 60) + 2, note: 'Carro, app ou táxi · estimativa sem trânsito' });
    opts.push(o);
  }
  legOptions.push([[], ...opts]);
  mapData.push({ date: d.date, stops: d.items.map((i) => ({ type: i.type, name: i.name, time: i.time, lat: i.lat, lng: i.lng })), legs });
}
const dirUrl = (a: Item, b: Item, mode: string) => `https://www.google.com/maps/dir/?api=1&origin=${a.lat},${a.lng}&destination=${b.lat},${b.lng}&travelmode=${mode === 'walk' ? 'walking' : mode === 'car' ? 'driving' : 'transit'}`;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#fbfbfa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121416" media="(prefers-color-scheme: dark)" />
    <script is:inline>document.documentElement.classList.add('js'); try { localStorage.getItem('map-off') && document.documentElement.classList.add('map-off'); } catch {}</script>
    <title>{trip.title} · Roteiro</title>
  </head>
  <body>
    <div class="layout">
      <main class="plan">
        <header class="trip">
          <h1>{trip.title}</h1>
          <button type="button" class="next-card" hidden><span class="now-tag"></span><span class="next-main"></span><span class="next-leg"></span></button>
          <ul class="chips">
            <li class="chip">{date(first, { day: 'numeric' })}–{date(last, { day: 'numeric', month: 'short' }).replace('.', '')}</li>
            <li class="chip total">{local.format(total)}<span class="sr">por pessoa</span>{foreign && <span class="conv">{conv(total)}</span>}</li>
            {trip.countries?.length ? (
              <li class="chip flags">{trip.countries.map((c) => <span role="img" aria-label={countryName.of(c)} title={countryName.of(c)}>{flag(c)}</span>)}</li>
            ) : null}
            <li class="chip people" aria-label={trip.people?.join(', ') ?? `${trip.travelers} pessoas`}>
              {trip.people
                ? trip.people.map((n) => <span class="avatar" title={n} aria-hidden="true">{n[0]}</span>)
                : <><Icon name="users" size={15} /> {trip.travelers}</>}
            </li>
          </ul>
          {foreign && <p class="rate">{rate}</p>}
          {trip.placeholder && <p class="notice"><Icon name="info" size={16} /> Exemplo: os lugares existem, mas preços, horários e deslocamentos são fictícios.</p>}
        </header>

        <nav class="days" aria-label="Dias do roteiro">
          {trip.days.map((d, n) => (
            <a href={`#dia-${n + 1}`} aria-label={`Dia ${n + 1}, ${date(d.date, { weekday: 'long', day: 'numeric', month: 'long' })}`} data-day={n} data-date={d.date} aria-current={n === 0 ? 'true' : undefined}>
              <span class="days-w">{date(d.date, { weekday: 'short' }).replace('.', '')}</span>
              <span class="days-d">{date(d.date, { day: 'numeric' })}</span>
              <span class="days-m">{date(d.date, { month: 'short' }).replace('.', '')}</span>
            </a>
          ))}
          <button type="button" class="days-next" hidden></button>
        </nav>

        {trip.days.map((d, n) => (
          <section class={n === 0 ? 'day is-current' : 'day'} id={`dia-${n + 1}`} data-day={n} aria-labelledby={`dia-${n + 1}-h`}>
            <header class="day-head">
              <h2 id={`dia-${n + 1}-h`}>
                <span class="day-date">{date(d.date, { weekday: 'long', day: 'numeric', month: 'long' })}</span>
                {d.title}
              </h2>
              <p class="day-meta"><span class="money">{local.format(dayCost(d))}{foreign && <span class="conv">{conv(dayCost(d))}</span>}</span> · {minutes(dayTravel(d))} em trânsito</p>
            </header>

            <ol class="timeline">
              {d.items.map((i, k) => (
                <>
                  {i.leg && (
                    <li class="leg">
                      <Icon name={i.leg.mode} size={15} />
                      <details class="leg-box">
                        <summary>
                          <span class="leg-text"><span class="sr">Deslocamento: </span><strong>{minutes(i.leg.minutes)}</strong> {modeLabel[i.leg.mode]}{i.leg.label && <span class="leg-label"> · {i.leg.label}</span>}{i.leg.cost ? <> · <span class="leg-cost">{local.format(i.leg.cost)}{foreign && <span class="conv">{conv(i.leg.cost)}</span>}</span></> : null}</span>
                          <Icon name="chevron" size={14} />
                        </summary>
                        <ul class="leg-options">
                          {legOptions[n][k].map((o) => (
                            <li class={o.planned ? 'is-planned' : undefined}>
                              <Icon name={o.mode} size={16} />
                              <span class="lo-what"><span class="lo-mode">{modeName[o.mode] ?? o.mode}{o.planned && <span class="lo-tag">no roteiro</span>}</span><span class="lo-note">{[o.note, o.km && km(o.km)].filter(Boolean).join(' · ')}</span></span>
                              <span class="lo-fig"><strong>{minutes(o.minutes)}</strong>{o.cost ? <span class="lo-cost">{local.format(o.cost)}{foreign && <span class="conv">{conv(o.cost)}</span>}</span> : null}</span>
                            </li>
                          ))}
                        </ul>
                        <a class="leg-maps" href={dirUrl(d.items[k - 1], i, i.leg.mode)} target="_blank" rel="noopener"><Icon name="external" size={14} /> Rotas e preço de app no Google Maps</a>
                      </details>
                    </li>
                  )}
                  <li class="stop" data-type={i.type} data-day={n} data-stop={k} data-date={d.date} data-time={i.time} data-end={i.end}>
                    <p class="stop-time">
                      <time datetime={`${d.date}T${i.time}`}>{i.time}</time>
                      {i.end && <time class="stop-end" datetime={`${d.date}T${i.end}`}><span class="sr">até </span>{i.end}</time>}
                    </p>
                    <span class="stop-pin" title={typeLabel[i.type]}>{k + 1}<span class="sr"> · {typeLabel[i.type]}</span></span>
                    <h3><button type="button" class="stop-link" data-day={n} data-stop={k} aria-controls="detail" aria-expanded="false">{i.name}</button><span class="now-tag">Próximo</span></h3>
                    <p class="stop-meta">
                      <span class="stop-cat"><Icon name={i.type} size={12} />{typeLabel[i.type]}</span>
                      {i.cost !== undefined && <span class="stop-cost">{i.cost === 0 ? 'Grátis' : <>{local.format(i.cost)}{foreign && <span class="conv">{conv(i.cost)}</span>}</>}</span>}
                      {i.alternatives?.length ? (
                        <button type="button" class="alt-toggle" aria-expanded="false" aria-controls={`alt-${n}-${k}`}>
                          <Icon name="swap" size={13} />{i.alternatives.length}<span class="sr"> {i.alternatives.length > 1 ? 'alternativas' : 'alternativa'} para {i.name}</span>
                        </button>
                      ) : null}
                    </p>
                    {i.alternatives?.length ? (
                      <ul class="alts" id={`alt-${n}-${k}`} hidden>
                        {i.alternatives.map((a) => (
                          <li data-type={a.type ?? i.type}>
                            <a href={altUrl(a)} target="_blank" rel="noopener">
                              <span class="alt-name">{a.name}</span>
                              <span class="alt-meta">
                                <span class="stop-cat"><Icon name={a.type ?? i.type} size={12} />{typeLabel[a.type ?? i.type]}</span>
                                {a.place?.rating && <span class="rating"><Icon name="star" size={12} />{a.place.rating.toLocaleString('pt-BR', { minimumFractionDigits: 1 })}</span>}
                                {a.time && <span>{a.time}{a.end && `–${a.end}`}</span>}
                                {a.cost !== undefined && <span class="stop-cost">{a.cost === 0 ? 'Grátis' : <>{local.format(a.cost)}{foreign && <span class="conv">{conv(a.cost)}</span>}</>}</span>}
                              </span>
                              {a.note && <span class="alt-note">{a.note}</span>}
                              <Icon name="external" size={14} />
                            </a>
                          </li>
                        ))}
                      </ul>
                    ) : null}
                    <span class="stop-thumb" aria-hidden="true">{photos(i)[0] ? <img src={photos(i)[0].src} alt="" loading="lazy" decoding="async" /> : <Icon name={i.type} size={18} />}</span>
                  </li>
                </>
              ))}
            </ol>

            <nav class="day-nav" aria-label="Outros dias">
              {n > 0 && <button type="button" data-go={n - 1}><Icon name="chevron" size={16} /><span><small>Dia anterior</small><b>{date(trip.days[n - 1].date, { weekday: 'short', day: 'numeric', month: 'short' })}</b></span></button>}
              {n < trip.days.length - 1 && <button type="button" data-go={n + 1} class="day-nav-next"><span><small>Próximo dia</small><b>{date(trip.days[n + 1].date, { weekday: 'short', day: 'numeric', month: 'short' })}</b></span><Icon name="chevron" size={16} /></button>}
            </nav>
          </section>
        ))}

      </main>

      <aside class="mapwrap" aria-label="Mapa do roteiro">
        <div id="map"></div>
        <p class="map-status" role="status">Carregando mapa…</p>
        <section id="detail" class="detail-panel" aria-label="Detalhes do lugar" hidden>
          <button type="button" class="detail-close" aria-label="Fechar detalhes"><Icon name="close" size={18} /></button>
          {trip.days.map((d, n) => d.items.map((i, k) => (
            <article class="detail" data-day={n} data-stop={k} data-type={i.type} hidden>
              {photos(i).length ? (
                <div class="gallery" tabindex="0" aria-label={`Fotos de ${i.name}`}>
                  {photos(i).map((ph) => (
                    <figure>
                      <img data-src={ph.src} alt="" decoding="async" />
                      <figcaption><a href={ph.page} target="_blank" rel="noopener">{[ph.author, ph.license].filter(Boolean).join(' · ') || 'Wikimedia Commons'}</a></figcaption>
                    </figure>
                  ))}
                </div>
              ) : null}
              <div class="detail-body">
                <p class="detail-type"><span class="detail-icon"><Icon name={i.type} size={14} /></span>{typeLabel[i.type]} · {date(d.date, { weekday: 'short', day: 'numeric', month: 'short' })} · {i.time}{i.end && `–${i.end}`}</p>
                <h2 tabindex="-1">{i.name}</h2>
                {(i.place?.rating || i.cost !== undefined) && (
                  <p class="detail-sub">
                    {i.place?.rating && <span class="rating"><Icon name="star" size={14} /><strong>{i.place.rating.toLocaleString('pt-BR', { minimumFractionDigits: 1 })}</strong> no Google</span>}
                    {i.cost !== undefined && <span class="detail-cost">{i.cost === 0 ? 'Grátis' : <>{local.format(i.cost)}{conv(i.cost) && <span> {conv(i.cost)}</span>}</>}</span>}
                  </p>
                )}
                {/* Actions first: on the street the next move is usually "take me there" or "check it out". */}
                <ul class="detail-actions">
                  <li><a class="is-primary" href={i.place?.googleMapsUrl ?? `https://www.google.com/maps/search/?api=1&query=${i.lat},${i.lng}`} target="_blank" rel="noopener"><Icon name="map" size={16} />Google Maps</a></li>
                  {i.place?.website && <li><a href={i.place.website} target="_blank" rel="noopener" title={host(i.place.website)}><Icon name="globe" size={16} />Site</a></li>}
                  {i.place?.instagram && <li><a href={i.place.instagram} target="_blank" rel="noopener"><Icon name="instagram" size={16} />Instagram</a></li>}
                  {i.place?.tripadvisorUrl && <li><a href={i.place.tripadvisorUrl} target="_blank" rel="noopener"><Icon name="reviews" size={16} />Tripadvisor</a></li>}
                </ul>
                {i.note && <p class="detail-note">{i.note}</p>}
                {(i.place?.address || i.place?.hours || i.place?.phone) && (
                  <dl class="detail-facts">
                    {i.place.address && <div><dt>Endereço</dt><dd>{i.place.address}</dd></div>}
                    {i.place.hours && <div><dt>Horário{i.place.osm && <small>segundo o OpenStreetMap</small>}</dt><dd>{hoursPt(i.place.hours).map((h) => <span>{h}</span>)}</dd></div>}
                    {i.place.phone && <div><dt>Telefone</dt><dd><a href={`tel:${i.place.phone.replace(/[^+\d]/g, '')}`}>{i.place.phone}</a></dd></div>}
                  </dl>
                )}
              </div>
            </article>
          )))}
        </section>
        <button type="button" class="map-close"><Icon name="list" size={18} /> <span class="on-phone">Lista</span><span class="on-desk">Ocultar mapa</span></button>
      </aside>
    </div>

    <button type="button" class="map-open"><Icon name="map" size={18} /> <span class="on-phone">Ver no mapa</span><span class="on-desk">Mostrar mapa</span></button>

    <script type="application/json" id="trip-map" set:html={JSON.stringify(mapData)} />
    <script>
      import L from 'leaflet';
      import 'leaflet/dist/leaflet.css';

      type Stop = { type: string; name: string; time: string; lat: number; lng: number };
      const days: { date: string; stops: Stop[]; legs: ([number, number][] | null)[] }[] = JSON.parse(document.getElementById('trip-map')!.textContent!);
      const root = document.documentElement;
      const mobile = matchMedia('(max-width: 959px)');

      const map = L.map('map', { zoomControl: false });
      L.control.zoom({ position: 'bottomright' }).addTo(map);
      map.attributionControl.setPrefix(false);
      // The timeline never depends on the map: tile failures only change the status line.
      const status = document.querySelector<HTMLElement>('.map-status')!;
      // Esri World Street Map (keyless, Google-like palette); at night the same tiles are dimmed by --tiles.
      const tiles = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}', { maxZoom: 19, attribution: 'Tiles © <a href="https://www.esri.com">Esri</a> · © <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>' }).addTo(map);
      let tileOk = false;
      tiles.on('tileload', () => { tileOk = true; status.hidden = true; });
      tiles.on('tileerror', () => { if (!tileOk) { status.hidden = false; status.textContent = 'Mapa indisponível sem conexão'; } });
      const accent = () => getComputedStyle(root).getPropertyValue('--accent').trim();
      const layer = L.layerGroup().addTo(map);
      let markers: L.Marker[] = [];
      let current = -1;

      // Time states in the viewer's local clock: past (ended), now (in progress), next (first upcoming today), future.
      // Recomputed every minute and whenever the tab comes back, so a page left open mid-trip stays right.
      // ?agora=2026-11-12T13:00 pins the clock, to preview a trip day before it happens.
      const pinned = new URLSearchParams(location.search).get('agora');
      const stopEls = [...document.querySelectorAll<HTMLElement>('.stop')];
      const state = new Map<string, string>();
      let today = '';
      let focus: HTMLElement | undefined;
      const card = document.querySelector<HTMLButtonElement>('.next-card')!;
      const jump = document.querySelector<HTMLButtonElement>('.days-next')!;
      function updateTimes() {
        const nowD = pinned ? new Date(pinned) : new Date();
        today = nowD.toLocaleDateString('sv-SE');
        const hhmm = nowD.toTimeString().slice(0, 5);
        state.clear();
        for (const [i, el] of stopEls.entries()) {
          // Without an end time, a stop lasts until the next stop of the same day starts.
          const after = stopEls[i + 1]?.dataset.date === el.dataset.date ? stopEls[i + 1].dataset.time! : '23:59';
          const d = el.dataset.date!, t = el.dataset.time!, end = el.dataset.end || after;
          const s = d < today || (d === today && end < hhmm) ? 'past' : d === today && t <= hhmm ? 'now' : '';
          if (s) state.set(`${el.dataset.day}-${el.dataset.stop}`, s);
        }
        const upcoming = stopEls.find((el) => el.dataset.date === today && el.dataset.time! > hhmm);
        if (upcoming) state.set(`${upcoming.dataset.day}-${upcoming.dataset.stop}`, 'next');
        focus = undefined;
        for (const el of stopEls) {
          const s = state.get(`${el.dataset.day}-${el.dataset.stop}`) ?? '';
          el.classList.remove('is-past', 'is-now', 'is-next');
          if (s) el.classList.add(`is-${s}`);
          if (s === 'now' || s === 'next') { el.querySelector('.now-tag')!.textContent = s === 'now' ? 'Agora' : 'Próximo'; focus ??= el; }
        }
        document.querySelectorAll<HTMLElement>('.days a').forEach((a) => a.classList.toggle('is-today', a.dataset.date === today));
        // The card names the current or next stop and how to get there; it only exists during the trip.
        card.hidden = jump.hidden = !focus;
        if (focus) {
          const label = focus.querySelector('.now-tag')!.textContent!;
          const time = focus.querySelector('time')!.textContent!;
          const name = focus.querySelector('.stop-link')!.textContent!;
          const leg = focus.previousElementSibling?.classList.contains('leg') ? focus.previousElementSibling.querySelector('.leg-text')!.textContent!.replace('Deslocamento: ', '').replace(/\s+/g, ' ').trim() : '';
          card.querySelector('.now-tag')!.textContent = label;
          card.querySelector('.next-main')!.textContent = `${time} · ${name}`;
          card.querySelector('.next-leg')!.textContent = leg;
          card.setAttribute('aria-label', `${label}: ${time}, ${name}${leg ? `. ${leg}` : ''}. Ir para a parada`);
          jump.textContent = `${label} ${time}`;
          jump.setAttribute('aria-label', `Ir para ${label.toLowerCase()}: ${time}, ${name}`);
        }
      }
      const goToFocus = () => { if (!focus) return; showDay(Number(focus.dataset.day)); focus.scrollIntoView({ behavior: motion(), block: 'center' }); focus.querySelector<HTMLElement>('.stop-link')!.focus({ preventScroll: true }); };
      card.addEventListener('click', goToFocus);
      jump.addEventListener('click', goToFocus);
      const stateOf = (n: number, k: number) => state.get(`${n}-${k}`) ?? '';
      const reduce = matchMedia('(prefers-reduced-motion: reduce)');
      const motion = (): ScrollBehavior => (reduce.matches ? 'auto' : 'smooth');

      function showDay(n: number, fit = true) {
        if (n === current) return;
        current = n;
        layer.clearLayers();
        const pts = days[n].stops.map((s) => L.latLng(s.lat, s.lng));
        pts.slice(1).forEach((b, k) => {
          const leg = days[n].legs[k];
          L.polyline(leg ?? [pts[k], b], { color: accent(), weight: 4, opacity: leg ? 0.85 : 1, dashArray: leg ? undefined : '1 8', lineCap: 'round' }).addTo(layer);
        });
        markers = days[n].stops.map((s, k) =>
          L.marker([s.lat, s.lng], {
            icon: L.divIcon({ className: `pin pin-${s.type}${stateOf(n, k) ? ' is-' + stateOf(n, k) : ''}`, html: `<span>${k + 1}</span>`, iconSize: [28, 28] }),
            title: s.name,
          })
            .bindTooltip(`${s.time} · ${s.name}`, { direction: 'top', offset: [0, -14] })
            .on('click', () => focusStop(n, k, false))
            .addTo(layer),
        );
        // One day at a time: its tab is current and only its section is shown.
        document.querySelectorAll<HTMLElement>('.days a').forEach((a) => {
          a.toggleAttribute('aria-current', Number(a.dataset.day) === n);
          // Keep the current tab visible in the strip without scrolling the page.
          const strip = a.parentElement!;
          if (Number(a.dataset.day) === n && (a.offsetLeft < strip.scrollLeft || a.offsetLeft + a.offsetWidth > strip.scrollLeft + strip.clientWidth)) strip.scrollLeft = a.offsetLeft - 16;
        });
        document.querySelectorAll<HTMLElement>('.day').forEach((s) => s.classList.toggle('is-current', Number(s.dataset.day) === n));
        history.replaceState(null, '', `#dia-${n + 1}`);
        if (fit) fitDay();
      }

      function fitDay() {
        const pts = days[current].stops.map((s) => L.latLng(s.lat, s.lng));
        map.fitBounds(L.latLngBounds(pts), { padding: [48, 48], maxZoom: 15 });
      }

      function focusStop(n: number, k: number, fromList: boolean) {
        showDay(n, false);
        const s = days[n].stops[k];
        const z = Math.max(map.getZoom(), 15);
        map.flyTo(clearOfPanel(L.latLng(s.lat, s.lng), z), z, { duration: 0.6, animate: !reduce.matches });
        markers.forEach((m, i) => m.getElement()?.classList.toggle('is-active', i === k));
        markers[k].openTooltip();
        document.querySelectorAll('.stop.is-active').forEach((e) => e.classList.remove('is-active'));
        const li = document.querySelector<HTMLElement>(`.stop[data-day="${n}"][data-stop="${k}"]`);
        li?.classList.add('is-active');
        if (!fromList && !mobile.matches) li?.scrollIntoView({ behavior: motion(), block: 'center' });
      }

      // The detail panel covers the right side (desktop) or the bottom (phone): offset the centre so the pin lands in the visible part.
      function clearOfPanel(ll: L.LatLng, z: number) {
        if (panel.hidden) return ll;
        const p = panel.getBoundingClientRect(), m = map.getContainer().getBoundingClientRect();
        const shift = mobile.matches ? L.point(0, (m.bottom - p.top) / 2) : L.point(p.width / 2, 0);
        return map.unproject(map.project(ll, z).add(shift), z);
      }

      // On phones the map is hidden until opened, so it must be resized before any move.
      // Desktop shows the map beside the list unless the viewer hid it; the choice is remembered.
      // On phones the open map is a modal sheet: the list behind it goes inert and focus moves into it and back.
      const plan = document.querySelector<HTMLElement>('.plan')!;
      const mapwrap = document.querySelector<HTMLElement>('.mapwrap')!;
      const mapOpen = document.querySelector<HTMLButtonElement>('.map-open')!;
      const mapClose = document.querySelector<HTMLButtonElement>('.map-close')!;
      function openMap(open: boolean, fit = true) {
        if (!mobile.matches) {
          root.classList.toggle('map-off', !open);
          try { localStorage.setItem('map-off', open ? '' : '1'); } catch {}
        }
        const sheet = open && mobile.matches, wasSheet = root.classList.contains('map-is-open');
        root.classList.toggle('map-is-open', sheet);
        plan.inert = mapOpen.inert = sheet;
        if (sheet) { mapwrap.setAttribute('role', 'dialog'); mapwrap.setAttribute('aria-modal', 'true'); }
        else { mapwrap.removeAttribute('role'); mapwrap.removeAttribute('aria-modal'); }
        map.invalidateSize();
        if (open && fit) fitDay();
        if (sheet && !wasSheet) mapClose.focus();
        else if (!sheet && wasSheet) (openLink ?? mapOpen).focus({ preventScroll: true });
      }

      // Clicking a row opens its details over the map column; hovering only previews it on the map.
      const panel = document.getElementById('detail')!;
      let openLink: HTMLButtonElement | undefined;
      function openDetail(b: HTMLButtonElement) {
        const n = Number(b.dataset.day), k = Number(b.dataset.stop);
        if (mobile.matches || root.classList.contains('map-off')) openMap(true, false);
        panel.querySelectorAll<HTMLElement>('.detail').forEach((a) => (a.hidden = !(a.dataset.day === String(n) && a.dataset.stop === String(k))));
        // Gallery photos load only when their item is opened.
        panel.querySelectorAll<HTMLImageElement>('.detail:not([hidden]) img[data-src]').forEach((img) => { img.src = img.dataset.src!; img.removeAttribute('data-src'); });
        panel.querySelector<HTMLElement>('.detail:not([hidden]) .gallery')?.scrollTo({ left: 0 });
        panel.hidden = false;
        root.classList.add('detail-open');
        openLink?.setAttribute('aria-expanded', 'false');
        openLink = b;
        b.setAttribute('aria-expanded', 'true');
        map.invalidateSize();
        focusStop(n, k, true);
        panel.querySelector<HTMLElement>('.detail:not([hidden]) h2')!.focus({ preventScroll: true });
      }
      function closeDetail() {
        if (panel.hidden) return false;
        panel.hidden = true;
        root.classList.remove('detail-open');
        openLink?.setAttribute('aria-expanded', 'false');
        if (!plan.inert) openLink?.focus({ preventScroll: true });
        requestAnimationFrame(() => map.invalidateSize());
        return true;
      }
      panel.querySelector('.detail-close')!.addEventListener('click', closeDetail);
      document.querySelectorAll<HTMLButtonElement>('.stop-link').forEach((b) => {
        b.addEventListener('click', () => openDetail(b));
        b.closest('.stop')!.addEventListener('mouseenter', () => !mobile.matches && !root.classList.contains('map-off') && !root.classList.contains('detail-open') && focusStop(Number(b.dataset.day), Number(b.dataset.stop), true));
      });
      mapOpen.addEventListener('click', () => openMap(true));
      mapClose.addEventListener('click', () => { closeDetail(); openMap(false); });
      addEventListener('keydown', (e) => e.key === 'Escape' && !closeDetail() && mobile.matches && openMap(false));

      // Tabs and the day-end buttons switch days; once the strip is stuck, the new day starts at its top.
      const trip = document.querySelector<HTMLElement>('.trip')!;
      function goToDay(n: number) {
        showDay(n);
        const top = trip.offsetTop + trip.offsetHeight;
        if (scrollY > top) scrollTo({ top, behavior: 'auto' });
      }
      document.querySelectorAll<HTMLAnchorElement>('.days a').forEach((a) => a.addEventListener('click', (e) => { e.preventDefault(); goToDay(Number(a.dataset.day)); }));
      document.querySelectorAll<HTMLButtonElement>('.day-nav button').forEach((b) => b.addEventListener('click', () => {
        goToDay(Number(b.dataset.go));
        document.querySelector<HTMLElement>(`.days a[data-day="${b.dataset.go}"]`)!.focus({ preventScroll: true });
      }));

      // Alternatives open inline under their stop.
      document.querySelectorAll<HTMLButtonElement>('.alt-toggle').forEach((b) => b.addEventListener('click', () => {
        const open = b.getAttribute('aria-expanded') !== 'true';
        b.setAttribute('aria-expanded', String(open));
        document.getElementById(b.getAttribute('aria-controls')!)!.hidden = !open;
      }));

      updateTimes();
      // Opening day: today during the trip, else the linked day (#dia-N), else the first.
      const todayIdx = days.findIndex((d) => d.date === today);
      const hashIdx = Number(location.hash.match(/^#dia-(\d+)$/)?.[1]) - 1;
      showDay(todayIdx >= 0 ? todayIdx : days[hashIdx] ? hashIdx : 0);
      focus?.scrollIntoView({ block: 'center' });
      const refresh = () => { updateTimes(); const n = current; current = -1; showDay(n, false); };
      setInterval(refresh, 60_000);
      document.addEventListener('visibilitychange', () => document.visibilityState === 'visible' && refresh());

      // Redraw the route when the system theme flips, so it follows the accent.
      matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => { const n = current; current = -1; showDay(n, false); });
    </script>
  </body>
</html>
