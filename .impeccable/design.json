  "components": [
    {
      "name": "Day Tab",
      "kind": "nav",
      "refersTo": "day-tab",
      "description": "Day Tab",
      "html": "<nav class=\"ds-days\"><a class=\"ds-tab\" aria-current=\"true\" href=\"#\"><b>Dia 1</b><span>sáb., 14 jun.</span></a><a class=\"ds-tab\" href=\"#\"><b>Dia 2</b><span>dom., 15 jun.</span></a></nav>",
      "css": ".ds-days{display:flex;gap:6px}.ds-tab{display:grid;min-height:44px;align-content:center;padding:6px 14px;border-radius:999px;border:1px solid #e6e7e4;background:#fff;color:#555b63;text-decoration:none;line-height:1.2;font:400 .75rem system-ui,sans-serif;transition:background-color .2s,color .2s,border-color .2s}.ds-tab b{font-size:.875rem;font-weight:600}.ds-tab:hover{border-color:#cfd2cd;color:#17191c}.ds-tab[aria-current]{background:#17191c;border-color:#17191c;color:#fff}.ds-tab:focus-visible{outline:2px solid #b93d0a;outline-offset:2px}"
    },
    {
      "name": "Timeline Stop",
      "kind": "custom",
      "refersTo": "stop-row-active",
      "description": "Timeline Stop",
      "html": "<div class=\"ds-stop is-next\"><div class=\"ds-time\">10:00<small>até 12:30</small></div><span class=\"ds-pin\">2</span><div><span class=\"ds-type\">Lugar <i>Próximo</i></span><h3>Mosteiro dos Jerónimos</h3><p>Exemplo — dado fictício.</p></div><div class=\"ds-cost\">€ 12,00<span>≈ R$ 72</span></div></div>",
      "css": ".ds-stop{display:grid;grid-template-columns:52px 28px 1fr auto;gap:12px;padding:8px 0 12px;border-radius:12px;font:400 1rem/1.5 system-ui,sans-serif;font-variant-numeric:tabular-nums;color:#17191c}.ds-stop:hover{background:#fdeee4}.ds-time{font-weight:600;font-size:.9375rem;display:grid}.ds-time small{font-size:.75rem;font-weight:400;color:#646a72}.ds-pin{width:28px;height:28px;border-radius:50%;display:grid;place-items:center;border:2px solid #17191c;background:#fff;font-size:.8125rem;font-weight:700}.is-next .ds-pin{background:#b93d0a;border-color:#b93d0a;color:#fff}.ds-type{font-size:.75rem;font-weight:600;color:#2f5fa8}.ds-type i{font-style:normal;margin-left:6px;padding:1px 7px;border-radius:999px;background:#b93d0a;color:#fff;font-size:.6875rem}.ds-stop h3{margin:2px 0 0;font-size:1.0625rem;font-weight:600;line-height:1.3}.ds-stop p{margin:4px 0 0;font-size:.875rem;color:#555b63}.ds-cost{font-weight:600;font-size:.9375rem;white-space:nowrap}.ds-cost span{color:#646a72;font-weight:400;font-size:.875em;margin-left:4px}"
    },
    {
      "name": "Locate Button",
      "kind": "button",
      "refersTo": "locate-button",
      "description": "Locate Button",
      "html": "<button class=\"ds-locate\" aria-label=\"Ver no mapa\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z\"/><circle cx=\"12\" cy=\"10\" r=\"2.5\"/></svg></button>",
      "css": ".ds-locate{width:36px;height:36px;border-radius:50%;display:grid;place-items:center;border:1px solid #e6e7e4;background:#fff;color:#555b63;cursor:pointer;transition:color .15s,border-color .15s}.ds-locate:hover{color:#b93d0a;border-color:#b93d0a}.ds-locate:active{background:#fdeee4}.ds-locate:focus-visible{outline:2px solid #b93d0a;outline-offset:2px}"
    },
