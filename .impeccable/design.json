  "narrative": {
    "northStar": "Folha de Bolso",
    "overview": "Category-standard travel timeline beside a live map at Wanderlog/Google Travel craft: quiet light world (with system dark theme), one signal orange for position and route, exact figures, pins mirrored on the map. Voice: agile and utilitarian; components soft and round.",
    "keyCharacteristics": [
      "Light default, full dark theme",
      "One orange accent for position and route",
      "Numbered rail mirrored on the map",
      "Past / current / future time states",
      "Local cost with ≈ R$ beside it",
      "Flat flow; shadows only for floating controls"
    ],
    "rules": [
      {
        "name": "The One Orange Rule",
        "body": "Orange marks where you are in the trip; nothing else.",
        "section": "colors"
      },
      {
        "name": "The Tint-Not-Fill Rule",
        "body": "Category colours only tint icon and label.",
        "section": "colors"
      },
      {
        "name": "The Contrast Floor Rule",
        "body": "No text below 4.5:1 in either theme; recede with ink-3, not opacity.",
        "section": "colors"
      },
      {
        "name": "The Tabular Rule",
        "body": "Every number tabular; cost always paired with ≈ R$.",
        "section": "typography"
      },
      {
        "name": "The Data-Above-Heading Rule",
        "body": "Only real data above a heading.",
        "section": "typography"
      },
      {
        "name": "The Float-Only Shadow Rule",
        "body": "Shadows only for things above the map or scroll.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do pair local cost with ≈ R$ and state the rate once",
      "Do mirror pin shape, number and state on the map",
      "Do keep tap targets ≥44px",
      "Do keep the timeline usable without the map"
    ],
    "donts": [
      "Don't wrap stops in cards",
      "Don't use category colours as fills",
      "Don't fade small text with opacity",
      "Don't show sample data without the notice",
      "Don't load web fonts"
    ]
  }
